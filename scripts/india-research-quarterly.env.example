# Copy to india-research-quarterly.env and adjust paths for your machine.
INVESTING_RESEARCH_DB=work/research.db
INVESTING_INDEX=NIFTY 50
INVESTING_BENCHMARK_INDEX=NIFTY 50
INVESTING_QUARTERS=4
INVESTING_PRICE_LOOKBACK_YEARS=3
INVESTING_FORWARD_DAYS=365
INVESTING_ARCHIVE_ALL_INDICES=true
INVESTING_ARCHIVE_CONSTITUENTS=true
INVESTING_HISTORICAL_CONSTITUENTS=true
INVESTING_USE_ACTIVE_PROFILE=true
INVESTING_EXPLAIN=true
INVESTING_PERSIST=true

# Optional orchestration notifications (default: notify when symbols are skipped)
# INVESTING_NOTIFY_ON=skipped
# INVESTING_NOTIFY_OUTPUT=work/orchestration-notifications.log
# INVESTING_NOTIFY_WEBHOOK_URL=https://example.com/hooks/orchestration
# INVESTING_NOTIFY_EMAIL_TO=you@example.com
# INVESTING_NOTIFY_EMAIL_FROM=research@example.com
# INVESTING_SMTP_HOST=smtp.example.com
# INVESTING_SMTP_PORT=587
# INVESTING_SMTP_USER=research@example.com
# INVESTING_SMTP_PASSWORD=secret
